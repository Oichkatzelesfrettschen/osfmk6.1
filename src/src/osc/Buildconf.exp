replace object_base ${sandbox_base}/obj/${target_machine}
replace export_base ${sandbox_base}/export/${target_machine}
replace source_base ${sandbox_base}/src
replace setenv EXPORTBASE ${export_base}
replace setenv SOURCEBASE ${source_base}
replace setenv MAKESYSPATH ${source_base}/usr/share/mk:${MAKESYSPATH}
replace setenv SOURCEDIR ${BACKED_SOURCEDIR}
replace setenv BACKED_SOURCEDIR ${source_base}:${SOURCEDIR}
replace setenv INCDIRS "-I${export_base}/usr/include ${INCDIRS}"
replace setenv LIBDIRS "-L${export_base}/usr/ccs/lib ${LIBDIRS}"
replace setenv SHLIBDIRS "-L${export_base}/usr/shlib ${SHLIBDIRS}"
replace setenv MACHO_SHLIBDIRS "-L${export_base}/usr/shlib ${MACHO_SHLIBDIRS}"
replace setenv ELF_SHLIBDIRS "-L${export_base}/usr/lib ${ELF_SHLIBDIRS}"
replace setenv SHLIBPATH "${export_base}/usr/lib:${SHLIBPATH}"

replace tools_base ${sandbox_base}/link/tools/${target_machine}

replace setenv MIGCOM ${tools_base}/hostbin/migcom
replace setenv TARGET_EXEC_PREFIX ${tools_base}/hostbin/
replace setenv ELF_GCC_EXEC_PREFIX "${tools_base}/elf/"
replace setenv MACHO_GCC_EXEC_PREFIX "${tools_base}/macho/"
replace setenv COFF_GCC_EXEC_PREFIX "${tools_base}/coff/"
replace setenv A_OUT_GCC_EXEC_PREFIX "${tools_base}/a_out/"
